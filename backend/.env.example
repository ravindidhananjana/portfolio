# ── Gemini API ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here          # from Google AI Studio
GEMINI_MODEL=gemini-2.0-flash                    # LLM model
GEMINI_EMBEDDING_MODEL=text-embedding-004        # embedding model (e.g. text-embedding-004 or gemini-embedding-001)

# ── GitHub ──────────────────────────────────────────────────
GITHUB_USERNAME=ravindidhananjana
GITHUB_TOKEN=your_github_pat_here                # optional but recommended to avoid 60 req/hr rate limit
GITHUB_EXCLUDE_REPOS=                            # comma-separated list to skip

# ── Agent ────────────────────────────────────────────────────
SYNC_SECRET=your_sync_secret_here               # protects /api/sync endpoint
MAX_RETRIEVAL_CHUNKS=5                           # how many chunks to retrieve

# ── Server ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000              # for CORS
