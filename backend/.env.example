# ── Gemini API ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here          # from Google AI Studio
GEMINI_MODEL=gemini-2.0-flash                    # primary LLM model
GEMINI_EMBEDDING_MODEL=text-embedding-004        # embedding model
# Comma-separated fallback Gemini models (tried in order if primary fails)
GEMINI_FALLBACK_MODELS=gemini-1.5-flash,gemini-1.5-pro

# ── OpenRouter API (fallback when all Gemini models fail) ───
# Get a free API key from https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Comma-separated free OpenRouter models (tried in order)
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.1-8b-instruct:free,google/gemma-2-9b-it:free,mistralai/mistral-7b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── GitHub ──────────────────────────────────────────────────
GITHUB_USERNAME=ravindidhananjana
GITHUB_TOKEN=your_github_pat_here                # optional but recommended to avoid 60 req/hr rate limit
GITHUB_EXCLUDE_REPOS=                            # comma-separated list to skip

# ── Agent ────────────────────────────────────────────────────
SYNC_SECRET=your_sync_secret_here               # protects /api/sync endpoint
MAX_RETRIEVAL_CHUNKS=5                           # how many chunks to retrieve

# ── Server ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000              # for CORS
